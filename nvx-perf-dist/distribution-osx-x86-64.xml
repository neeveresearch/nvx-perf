<?xml version="1.0" encoding="UTF-8"?>
<assembly xmlns="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.0 http://maven.apache.org/xsd/assembly-1.1.0.xsd">
    <id>dist-osx-x86-64</id>
    <baseDirectory>/</baseDirectory>
    <formats>
        <format>tar.gz</format>
    </formats>
    <fileSets>
        <!-- Collect all JARs (modules + dependencies) copied by maven-dependency-plugin -->
        <fileSet>
            <directory>${project.basedir}/target/dependency</directory>
            <outputDirectory>/nvx-perf-${project.version}/libs</outputDirectory>
            <includes>
                <include>*.jar</include>
            </includes>
        </fileSet>
        <!-- Collect conf files -->
        <fileSet>
            <directory>${project.parent.basedir}/nvx-perf-aep/conf</directory>
            <outputDirectory>/nvx-perf-${project.version}/conf</outputDirectory>
            <includes>
                <include>*</include>
            </includes>
        </fileSet>
    </fileSets>
</assembly>
